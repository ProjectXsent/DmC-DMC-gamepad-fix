{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "win32",
      "displayName": "Windows 32-bit (the game is x86)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "Win32", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/win32"
    },
    {
      "name": "tests-only",
      "displayName": "Unit tests only (any OS/compiler)",
      "binaryDir": "${sourceDir}/build/tests",
      "cacheVariables": {
        "DMC_BUILD_SHIM": "OFF",
        "DMC_BUILD_HARNESS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "win32-release", "configurePreset": "win32", "configuration": "Release" },
    { "name": "win32-debug",   "configurePreset": "win32", "configuration": "Debug" },
    { "name": "tests-only",    "configurePreset": "tests-only" }
  ],
  "testPresets": [
    { "name": "win32-release", "configurePreset": "win32", "configuration": "Release",
      "output": { "outputOnFailure": true } },
    { "name": "tests-only", "configurePreset": "tests-only",
      "output": { "outputOnFailure": true } }
  ]
}
